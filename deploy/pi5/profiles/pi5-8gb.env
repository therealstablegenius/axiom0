# AXIOM0 Living City — Raspberry Pi 5, 8 GB (recommended board)
# Plain KEY=value only: this file is read by systemd (EnvironmentFile) and by the installer.
PI5_PROFILE=pi5-8gb

# --- Model the AXIOM0 Mind uses (the v0.6 default model) ---
AXIOM0_MODEL=llama3.2:3b
AXIOM0_OLLAMA_URL=http://127.0.0.1:11434

# --- Request tuning (read by axiom0/llm.py) ---
# 4 excerpts ~= 2,300 prompt tokens. Prompt reading is the slow part on a Pi,
# so fewer excerpts = faster answers. Raise to 6 if answers miss context.
AXIOM0_LLM_SOURCES=4
AXIOM0_NUM_CTX=4096
AXIOM0_NUM_THREAD=4
AXIOM0_NUM_PREDICT=512
AXIOM0_LLM_TIMEOUT=420
AXIOM0_KEEP_ALIVE=30m

# --- Ollama server tuning (written into the ollama.service drop-in) ---
PI5_OLLAMA_KEEP_ALIVE=30m
PI5_OLLAMA_CONTEXT_LENGTH=4096
PI5_OLLAMA_FLASH_ATTENTION=1
PI5_OLLAMA_KV_CACHE_TYPE=q8_0

# --- System tuning ---
PI5_ZRAM=auto

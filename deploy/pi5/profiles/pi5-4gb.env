# AXIOM0 Living City — Raspberry Pi 5, 4 GB (also used for 2 GB boards, with a warning)
# Plain KEY=value only: this file is read by systemd (EnvironmentFile) and by the installer.
PI5_PROFILE=pi5-4gb

# --- Model the AXIOM0 Mind uses (1B keeps ~2 GB free for the OS and AXIOM0) ---
AXIOM0_MODEL=llama3.2:1b
AXIOM0_OLLAMA_URL=http://127.0.0.1:11434

# --- Request tuning (read by axiom0/llm.py) ---
# 3 excerpts ~= 1,800 prompt tokens; fits in 3072 with room for the answer.
AXIOM0_LLM_SOURCES=3
AXIOM0_NUM_CTX=3072
AXIOM0_NUM_THREAD=4
AXIOM0_NUM_PREDICT=384
AXIOM0_LLM_TIMEOUT=300
AXIOM0_KEEP_ALIVE=15m

# --- Ollama server tuning (written into the ollama.service drop-in) ---
PI5_OLLAMA_KEEP_ALIVE=15m
PI5_OLLAMA_CONTEXT_LENGTH=3072
PI5_OLLAMA_FLASH_ATTENTION=1
PI5_OLLAMA_KV_CACHE_TYPE=q8_0

# --- System tuning ---
# Compressed RAM swap, added only if the OS has no zram swap already.
PI5_ZRAM=yes

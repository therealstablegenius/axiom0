# AXIOM0 Living City — Raspberry Pi 5, 16 GB
# Plain KEY=value only: this file is read by systemd (EnvironmentFile) and by the installer.
PI5_PROFILE=pi5-16gb

# --- Model the AXIOM0 Mind uses ---
# 3B stays the default: on a Pi the CPU, not RAM, limits speed. For better
# answers at roughly half the speed, install with:  --model qwen2.5:7b
AXIOM0_MODEL=llama3.2:3b
AXIOM0_OLLAMA_URL=http://127.0.0.1:11434

# --- Request tuning (read by axiom0/llm.py) ---
# Full 6 excerpts (the desktop default), with a larger context window.
AXIOM0_LLM_SOURCES=6
AXIOM0_NUM_CTX=6144
AXIOM0_NUM_THREAD=4
AXIOM0_NUM_PREDICT=640
AXIOM0_LLM_TIMEOUT=600
# Keep the model loaded permanently: no reload delay on the first question.
AXIOM0_KEEP_ALIVE=-1

# --- Ollama server tuning (written into the ollama.service drop-in) ---
PI5_OLLAMA_KEEP_ALIVE=-1
PI5_OLLAMA_CONTEXT_LENGTH=6144
PI5_OLLAMA_FLASH_ATTENTION=1
PI5_OLLAMA_KV_CACHE_TYPE=q8_0

# --- System tuning ---
PI5_ZRAM=no

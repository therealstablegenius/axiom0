[Unit]
Description=AXIOM0 Living City local pilot (localhost:8765)
Documentation=file:///opt/axiom0/docs/PI5.md
After=network-online.target ollama.service
Wants=network-online.target ollama.service

[Service]
Type=simple
User=axiom0
Group=axiom0
WorkingDirectory=/var/lib/axiom0
EnvironmentFile=/etc/axiom0/axiom0.env
EnvironmentFile=/etc/axiom0/secrets.env
Environment=AXIOM0_DATA_DIR=/var/lib/axiom0
Environment=PYTHONDONTWRITEBYTECODE=1
# Binds 127.0.0.1:8765 only (hard-coded in axiom0/cli.py). Use an SSH tunnel to reach it.
ExecStart=/opt/axiom0/.venv/bin/python -P -m axiom0 --data-dir /var/lib/axiom0 serve
Restart=on-failure
RestartSec=5
# Keep the dashboard responsive while Ollama is using every core.
CPUWeight=200
Nice=-2

# --- Sandboxing ---
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/axiom0
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
